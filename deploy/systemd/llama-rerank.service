[Unit]
Description=llama-server (cross-encoder reranker, bge-reranker-v2-m3, port 8082)
Documentation=file:///home/pa-joshi/llama-cpp-projects/REAL_VS_MOCK.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
Environment=LD_LIBRARY_PATH=/home/pa-joshi/llama.cpp/build/bin
ExecStart=/home/pa-joshi/llama.cpp/build/bin/llama-server -hf gpustack/bge-reranker-v2-m3-GGUF:Q8_0 --host 127.0.0.1 --port 8082 --reranking --pooling rank -c 2048 -t 2
Restart=on-failure
RestartSec=5
# First boot may download the model via -hf; do not give up early.
TimeoutStartSec=900
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
