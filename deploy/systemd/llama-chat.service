[Unit]
Description=llama-server (chat, SmolLM2-360M, port 8090)
Documentation=file:///home/pa-joshi/llama-cpp-projects/REAL_VS_MOCK.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
Environment=LD_LIBRARY_PATH=/home/pa-joshi/llama.cpp/build/bin
ExecStart=/home/pa-joshi/llama.cpp/build/bin/llama-server -hf HuggingFaceTB/SmolLM2-360M-Instruct-GGUF:Q8_0 --host 127.0.0.1 --port 8090 -c 6144 --parallel 3 -t 2 --metrics
Restart=on-failure
RestartSec=5
# First boot may download the model via -hf; do not give up early.
TimeoutStartSec=900
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
